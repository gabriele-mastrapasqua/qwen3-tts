# tools/para: track the tools, never the virtualenv.
tools/para/.venv/
!tools/para/*.py
# tools/quant: fake-quant harness for offline quantization-format checks.
!tools/quant/*.py
# Benchmark and audio-inspection tooling. Listed one by one rather than with a directory
# wildcard: '*.py' is ignored by default here, and a tool that lands in tools/ without an
# entry is silently absent from the repository while looking present on disk.
!tools/perf_profile.py
!tools/wav_qc.py
!tools/onset_report.py
# No trailing slash: these may be symlinks rather than real directories.
qwen3-tts-0.6b
qwen3-tts-1.7b
qwen3-tts-0.6b-base
qwen3-tts-1.7b-base
qwen3-tts-voice-design
