# local bench scaffolds / archives (not part of the repo)
ab_*.sh
*.zip

# Local-only helper scripts.
scripts/

# expressivity artifacts (host on GH release/HF, do not commit big binaries)
qwen3-tts-1.7b-expr
# The .expr weight deltas are hosted on Hugging Face (gabrione/qwen3-tts-italian-expr) and
# fetched on demand by download_assets.sh, sha256-verified against presets/expr/MANIFEST.md,
# which is tracked. Large binaries stay out of git.
presets/expr/*.expr
!training/expressivity-lora/*.py
# Local-only trainer/sync scripts. Must come AFTER the *.py re-include above so they stay
# ignored.
training/expressivity-lora/gpu_*
training/expressivity-lora/sync_*to_gpu.sh
# local training data (prep outputs: wav24k + manifests + codes) — never commit
training/expressivity-lora/data*/

